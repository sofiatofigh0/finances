# ============================================================================
# Spendable — environment variables
# ============================================================================
# Copy to .env.local for local development, and add the same values in
# Netlify under Site configuration -> Environment variables for production.
#
# Anything WITHOUT the NEXT_PUBLIC_ prefix is server-only and must never be
# exposed to the browser.
# ============================================================================

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Local: http://localhost:3000
# Production: your Netlify URL, e.g. https://spendable.netlify.app
# Used for Supabase auth redirects and the Plaid webhook URL. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase  (Project Settings -> API Keys)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (new naming). If your project still shows "anon public",
# use that value here — the app accepts either.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret key (new naming) or "service_role" key. SERVER ONLY.
# Required for encrypted Plaid token storage, webhook processing, and cron sync.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Plaid  (https://dashboard.plaid.com -> Developers -> Keys)
# ---------------------------------------------------------------------------
PLAID_CLIENT_ID=
# Use your Sandbox secret to start; swap for the Production secret when your
# Production access is approved.
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox
# Only needed if you register an OAuth redirect URI in the Plaid dashboard.
# PLAID_REDIRECT_URI=https://your-site.netlify.app/accounts

# ---------------------------------------------------------------------------
# Anthropic  (https://console.anthropic.com -> API Keys)
# ---------------------------------------------------------------------------
# Optional: the whole app works without it, but the Agent tab shows a
# setup-required state until this is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Encryption  (REQUIRED before connecting any real institution)
# ---------------------------------------------------------------------------
# Encrypts Plaid access tokens at rest with AES-256-GCM.
# Generate with:  openssl rand -base64 32
# Changing this makes existing stored tokens unreadable — reconnect institutions
# if you rotate it.
FINANCIAL_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Scheduled sync
# ---------------------------------------------------------------------------
# Shared secret so only the Netlify Scheduled Function can trigger a sync.
# Generate with:  openssl rand -hex 32
SYNC_JOB_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Set to "false" in production to disable the demo-data loader in Settings.
ALLOW_DEMO_SEED=true
